FROM ros:jazzy-ros-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        fonts-noto-cjk \
        openbox \
        python3-pil \
        ros-jazzy-lifecycle-msgs \
        ros-jazzy-nav2-msgs \
        ros-jazzy-ros-gz-bridge \
        ros-jazzy-ros-gz-sim \
        ros-jazzy-rosidl-runtime-py \
        ros-jazzy-std-srvs \
        xauth \
        xdotool \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
