{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/robotics/soak-report-v1.schema.json",
  "title": "Flyto2 Robotics Deterministic Soak Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "generated_at",
    "passed",
    "requested_runs",
    "passed_runs",
    "failed_runs",
    "pass_rate",
    "deterministic",
    "unique_fingerprints",
    "runs"
  ],
  "properties": {
    "contract_version": {
      "const": "flyto.robotics.soak-report.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "passed": {"type": "boolean"},
    "requested_runs": {"type": "integer", "minimum": 1, "maximum": 500},
    "passed_runs": {"type": "integer", "minimum": 0, "maximum": 500},
    "failed_runs": {"type": "integer", "minimum": 0, "maximum": 500},
    "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "deterministic": {"type": "boolean"},
    "unique_fingerprints": {"type": "integer", "minimum": 1, "maximum": 500},
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run",
          "passed",
          "failures",
          "fingerprint",
          "elapsed_seconds",
          "safety_stop_count",
          "event_count"
        ],
        "properties": {
          "run": {"type": "integer", "minimum": 1, "maximum": 500},
          "passed": {"type": "boolean"},
          "failures": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "maxLength": 128}
          },
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "safety_stop_count": {"type": "integer", "minimum": 0},
          "event_count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
