{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/robotics/semantic-location-map-v1.schema.json",
  "title": "Flyto Robotics Semantic Location Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "map_id",
    "revision",
    "locations"
  ],
  "properties": {
    "contract_version": {
      "const": "flyto.robotics.semantic-location-map.v1"
    },
    "map_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "locations": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location_id",
          "labels",
          "pose"
        ],
        "properties": {
          "location_id": {
            "$ref": "#/$defs/identifier"
          },
          "labels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "pose": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "yaw"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000.0,
                "maximum": 1000.0
              },
              "y": {
                "type": "number",
                "minimum": -1000.0,
                "maximum": 1000.0
              },
              "yaw": {
                "type": "number",
                "minimum": -3.141592653589793,
                "maximum": 3.141592653589793
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
