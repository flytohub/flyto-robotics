{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/capability-route-v1.schema.json",
  "title": "Flyto Capability Route v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "registry_snapshot",
    "selection_method",
    "confidence",
    "needs_clarification",
    "candidates",
    "excluded_count",
    "excluded",
    "routing_context"
  ],
  "properties": {
    "contract_version": {"const": "flyto.capability-route.v1"},
    "registry_snapshot": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "selection_method": {
      "enum": [
        "hard_filter_then_deterministic_hybrid_rank_v1",
        "hard_filter_then_semantic_frame_rank_v1"
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_clarification": {"type": "boolean"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_id",
          "runtime_name",
          "score",
          "reasons",
          "selected_by"
        ],
        "properties": {
          "canonical_id": {"type": "string"},
          "runtime_name": {"type": "string"},
          "score": {"type": "number", "minimum": 0},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "selected_by": {
            "enum": [
              "deterministic_hybrid_v1",
              "deterministic_semantic_frame_v1"
            ]
          }
        }
      }
    },
    "excluded_count": {"type": "integer", "minimum": 0},
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime_name", "reasons"],
        "properties": {
          "runtime_name": {"type": "string"},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "routing_context": {"type": "object"},
    "goal_frame": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "goal-frame-v1.schema.json"}
      ]
    },
    "semantic_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "matched", "missing", "ratio"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "matched": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
