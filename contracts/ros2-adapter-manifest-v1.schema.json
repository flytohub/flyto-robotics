{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/ros2-adapter-manifest-v1.schema.json",
  "title": "Flyto2 ROS 2 Adapter Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_id",
    "robot_id",
    "ros_version",
    "fail_closed",
    "direct_actuation",
    "emergency_stop_required",
    "adapters",
    "snapshot"
  ],
  "properties": {
    "contract_version": {
      "const": "flyto.robotics.ros2-adapter-manifest.v1"
    },
    "profile_id": {"$ref": "#/$defs/identifier"},
    "robot_id": {"$ref": "#/$defs/identifier"},
    "ros_version": {"const": 2},
    "fail_closed": {"const": true},
    "direct_actuation": {"const": false},
    "emergency_stop_required": {"const": true},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/adapter"}
    },
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,191}$"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "capability_ids",
        "stack",
        "interface",
        "managed_nodes",
        "required_observations",
        "timeout_seconds",
        "supported_modes",
        "feedback_required",
        "cancel_on_timeout",
        "lifecycle_required",
        "goal_policy"
      ],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/identifier"},
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "stack": {
          "enum": ["nav2", "moveit2", "ros2_control", "flyto"]
        },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "type"],
          "properties": {
            "kind": {"enum": ["action", "service"]},
            "name": {
              "type": "string",
              "pattern": "^/(?!/)[A-Za-z0-9_/]+$",
              "maxLength": 192
            },
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*/(action|srv)/[A-Za-z][A-Za-z0-9_]*$",
              "maxLength": 192
            }
          }
        },
        "managed_nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/(?!/)[A-Za-z0-9_/]+$",
            "maxLength": 192
          }
        },
        "required_observations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3600
        },
        "supported_modes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["simulation", "hardware"]},
          "allOf": [
            {"contains": {"const": "simulation"}},
            {"contains": {"const": "hardware"}}
          ]
        },
        "feedback_required": {"const": true},
        "cancel_on_timeout": {"const": true},
        "lifecycle_required": {"const": true},
        "goal_policy": {"const": "semantic_only"}
      }
    }
  }
}
