{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/facility/resource-plan-v1.schema.json",
  "title": "Flyto2 Facility Resource Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "workflow_id",
    "target_space_id",
    "fail_closed",
    "executable",
    "configured_endpoint_count",
    "requirement_count",
    "selected",
    "missing",
    "excluded",
    "snapshot"
  ],
  "properties": {
    "schema_version": {"const": "ai-space-resource-plan.v1"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "workflow_id": {"$ref": "#/$defs/identifier"},
    "target_space_id": {"$ref": "#/$defs/identifier"},
    "fail_closed": {"const": true},
    "executable": {"const": true},
    "configured_endpoint_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "requirement_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "selected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/selection"}
    },
    "missing": {"type": "array", "maxItems": 0},
    "excluded": {"type": "array", "maxItems": 8192},
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "requirement_id",
        "unit",
        "capability_id",
        "lease_only",
        "endpoint_id",
        "resource_id",
        "adapter_id",
        "target_space_id",
        "score",
        "observation_sequence",
        "require_confirmation"
      ],
      "properties": {
        "step": {"type": "integer", "minimum": 1, "maximum": 128},
        "requirement_id": {"$ref": "#/$defs/identifier"},
        "unit": {"type": "integer", "minimum": 1, "maximum": 4},
        "capability_id": {"$ref": "#/$defs/identifier"},
        "lease_only": {"type": "boolean"},
        "endpoint_id": {"$ref": "#/$defs/identifier"},
        "resource_id": {"$ref": "#/$defs/identifier"},
        "adapter_id": {"$ref": "#/$defs/identifier"},
        "target_space_id": {"$ref": "#/$defs/identifier"},
        "score": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "observation_sequence": {
          "oneOf": [
            {"$ref": "#/$defs/observation"},
            {"type": "null"}
          ]
        },
        "require_confirmation": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S+$"
    }
  }
}
