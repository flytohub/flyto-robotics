{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/robotics/lab-matrix-v1.schema.json",
  "title": "Flyto2 Robotics Gazebo Lab Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "generated_at",
    "passed",
    "scenario_id",
    "requested_runs",
    "passed_runs",
    "failed_runs",
    "pass_rate",
    "consistent_assertions",
    "metrics",
    "runs"
  ],
  "properties": {
    "contract_version": {"const": "flyto.robotics.lab-matrix.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "passed": {"type": "boolean"},
    "scenario_id": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "requested_runs": {"type": "integer", "minimum": 1, "maximum": 20},
    "passed_runs": {"type": "integer", "minimum": 0, "maximum": 20},
    "failed_runs": {"type": "integer", "minimum": 0, "maximum": 20},
    "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "consistent_assertions": {"type": "boolean"},
    "metrics": {"type": "object"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "object"}
    }
  }
}
