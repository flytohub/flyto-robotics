{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/robotics/ros2-execution-evidence-v1.schema.json",
  "title": "Flyto ROS 2 Execution Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "execution_id", "scenario", "robot_id", "workflow_id",
    "target_space_id", "resource_id", "adapter_id", "capability_id",
    "semantic_map_id", "semantic_location_id", "goal_frame", "grant_snapshot",
    "resource_plan_snapshot", "profile_snapshot", "runtime_snapshot", "status",
    "result_code", "goal_accepted", "feedback_count", "initial_pose", "final_pose",
    "displacement_m", "goal_error_m", "post_stop_drift_m", "started_at", "finished_at",
    "duration_seconds", "cancel_requested", "cancel_reason",
    "safety_stop_observed", "safety_stop_reason", "fault_injection_observed",
    "safety_stop_latency_ms", "event_codes", "snapshot"
  ],
  "properties": {
    "contract_version": {"const": "flyto.robotics.ros2-execution-evidence.v1"},
    "execution_id": {"$ref": "#/$defs/id"},
    "scenario": {"enum": ["success", "cancel", "emergency_stop", "lidar_dropout", "odometry_freeze", "nav2_lifecycle_failure"]},
    "robot_id": {"$ref": "#/$defs/id"},
    "workflow_id": {"$ref": "#/$defs/id"},
    "target_space_id": {"$ref": "#/$defs/id"},
    "resource_id": {"$ref": "#/$defs/id"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "capability_id": {"$ref": "#/$defs/id"},
    "semantic_map_id": {"$ref": "#/$defs/id"},
    "semantic_location_id": {"$ref": "#/$defs/id"},
    "goal_frame": {"enum": ["map", "odom"]},
    "grant_snapshot": {"$ref": "#/$defs/digest"},
    "resource_plan_snapshot": {"$ref": "#/$defs/digest"},
    "profile_snapshot": {"$ref": "#/$defs/digest"},
    "runtime_snapshot": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["succeeded", "canceled", "safety_stopped", "timed_out", "rejected", "aborted"]},
    "result_code": {"enum": ["succeeded", "canceled", "rejected", "aborted"]},
    "goal_accepted": {"type": "boolean"},
    "feedback_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "initial_pose": {"$ref": "#/$defs/pose"},
    "final_pose": {"$ref": "#/$defs/pose"},
    "displacement_m": {"type": "number", "minimum": 0, "maximum": 3600},
    "goal_error_m": {"type": "number", "minimum": 0, "maximum": 3600},
    "post_stop_drift_m": {"type": "number", "minimum": 0, "maximum": 3600},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
    "cancel_requested": {"type": "boolean"},
    "cancel_reason": {"type": ["string", "null"], "enum": [null, "operator_cancel", "emergency_stop", "timeout", "lidar_stale", "odometry_stale", "command_stale"]},
    "safety_stop_observed": {"type": "boolean"},
    "safety_stop_reason": {"type": ["string", "null"], "enum": [null, "emergency_stop", "lidar_stale", "odometry_stale", "command_stale"]},
    "fault_injection_observed": {"type": "boolean"},
    "safety_stop_latency_ms": {"type": ["number", "null"], "minimum": 0, "maximum": 10000},
    "event_codes": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "snapshot": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,191}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pose": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "yaw"],
      "properties": {
        "x": {"type": "number", "minimum": -1000, "maximum": 1000},
        "y": {"type": "number", "minimum": -1000, "maximum": 1000},
        "yaw": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793}
      }
    }
  }
}
