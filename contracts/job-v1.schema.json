{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyto2.com/contracts/robotics/job-v1.schema.json",
  "title": "Flyto2 Robotics Hospital Delivery Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "job_id",
    "robot_id",
    "task_type",
    "pickup",
    "dropoff",
    "payload",
    "safety"
  ],
  "properties": {
    "contract_version": {
      "const": "flyto.robotics.job.v1"
    },
    "job_id": {
      "$ref": "#/$defs/identifier"
    },
    "robot_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_type": {
      "const": "hospital_delivery"
    },
    "pickup": {
      "$ref": "#/$defs/station"
    },
    "dropoff": {
      "$ref": "#/$defs/station"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "category",
        "sealed"
      ],
      "properties": {
        "payload_id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "medication",
            "specimen",
            "supplies",
            "documents"
          ]
        },
        "sealed": {
          "type": "boolean"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_linear_speed",
        "max_angular_speed",
        "obstacle_stop_distance",
        "pose_tolerance",
        "mission_timeout_seconds",
        "pickup_dwell_seconds",
        "dropoff_dwell_seconds"
      ],
      "properties": {
        "max_linear_speed": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.5
        },
        "max_angular_speed": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2.0
        },
        "obstacle_stop_distance": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 2.0
        },
        "pose_tolerance": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0
        },
        "mission_timeout_seconds": {
          "type": "number",
          "minimum": 10.0,
          "maximum": 3600.0
        },
        "pickup_dwell_seconds": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 60.0
        },
        "dropoff_dwell_seconds": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 60.0
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_id",
        "x",
        "y",
        "yaw"
      ],
      "properties": {
        "station_id": {
          "$ref": "#/$defs/identifier"
        },
        "x": {
          "type": "number",
          "minimum": -1000.0,
          "maximum": 1000.0
        },
        "y": {
          "type": "number",
          "minimum": -1000.0,
          "maximum": 1000.0
        },
        "yaw": {
          "type": "number",
          "minimum": -3.141592653589793,
          "maximum": 3.141592653589793
        }
      }
    }
  }
}
