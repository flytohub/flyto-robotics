<?xml version="1.0"?>
<sdf version="1.9">
  <world name="flyto_atomic_color_route">
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.94 0.96 0.98 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>
    <light name="route_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <model name="route_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry><box><size>10 6 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 6 0.10</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.72 1</ambient>
            <diffuse>0.84 0.86 0.88 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="route_blue">
      <static>true</static>
      <pose>-1.5 0 0.056 0 0 0</pose>
      <link name="line">
        <visual name="visual">
          <geometry><box><size>1.6 0.24 0.012</size></box></geometry>
          <material>
            <ambient>0.02 0.12 0.82 1</ambient>
            <diffuse>0.03 0.20 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="route_yellow">
      <static>true</static>
      <pose>0 0 0.056 0 0 0</pose>
      <link name="line">
        <visual name="visual">
          <geometry><box><size>1.4 0.24 0.012</size></box></geometry>
          <material>
            <ambient>0.86 0.68 0.01 1</ambient>
            <diffuse>1.0 0.90 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="route_purple">
      <static>true</static>
      <pose>1.5 0 0.056 0 0 0</pose>
      <link name="line">
        <visual name="visual">
          <geometry><box><size>1.6 0.24 0.012</size></box></geometry>
          <material>
            <ambient>0.46 0.04 0.68 1</ambient>
            <diffuse>0.72 0.08 0.96 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://flyto_rover</uri>
      <name>flyto_rover</name>
      <pose>-2.15 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
