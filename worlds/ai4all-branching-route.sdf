<?xml version="1.0"?>
<sdf version="1.9">
  <world name="flyto_atomic_color_route_lab">
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="Flyto2 Gazebo 3D View">
        <gz-gui>
          <title>Flyto2 Gazebo 3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.58 0.61 0.64</ambient_light>
        <background_color>0.82 0.88 0.92</background_color>
        <camera_pose>0.45 -6.5 6.2 0 0.72 1.5708</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Gazebo scene manager">
        <gz-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="Gazebo world control">
        <gz-gui>
          <title>Gazebo world control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">130</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="Flyto2 Gazebo 3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="Gazebo world stats">
        <gz-gui>
          <title>Gazebo world stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="Flyto2 Gazebo 3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>
    </gui>

    <scene>
      <ambient>0.58 0.61 0.64 1</ambient>
      <background>0.82 0.88 0.92 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>
    <light name="route_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <model name="hospital_floor">
