<?xml version="1.0"?>
<sdf version="1.9">
  <world name="flyto_atomic_color_route_lab">
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.82 0.82 0.82 1</ambient>
      <background>0.94 0.96 0.98 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>
    <light name="route_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <model name="route_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry><box><size>10 6 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 6 0.10</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.72 1</ambient>
            <diffuse>0.84 0.86 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="route_blue">
      <static>true</static>
      <pose>-1.5 0 0.056 0 0 0</pose>
      <link name="line">
        <visual name="visual">
          <geometry><box><size>1.6 0.24 0.012</size></box></geometry>
          <material>
            <ambient>0.02 0.12 0.82 1</ambient>
            <diffuse>0.03 0.20 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="route_yellow">
      <static>true</static>
      <pose>0 0 0.056 0 0 0</pose>
      <link name="line">
        <visual name="visual">
          <geometry><box><size>1.4 0.24 0.012</size></box></geometry>
          <material>
            <ambient>0.86 0.68 0.01 1</ambient>
            <diffuse>1.0 0.90 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="route_purple">
      <static>true</static>
      <pose>1.5 0 0.056 0 0 0</pose>
      <link name="line">
        <visual name="visual">
          <geometry><box><size>1.6 0.24 0.012</size></box></geometry>
          <material>
            <ambient>0.46 0.04 0.68 1</ambient>
            <diffuse>0.72 0.08 0.96 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hospital_corridor">
      <static>true</static>
      <link name="north_wall">
        <pose>0 1.45 0.9 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10 0.12 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.12 1.8</size></box></geometry>
          <material>
            <ambient>0.88 0.91 0.93 1</ambient>
            <diffuse>0.95 0.97 0.98 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="south_wall">
        <pose>0 -1.45 0.9 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10 0.12 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.12 1.8</size></box></geometry>
          <material>
            <ambient>0.88 0.91 0.93 1</ambient>
            <diffuse>0.95 0.97 0.98 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pharmacy_counter">
      <static>true</static>
      <pose>-3.15 0.95 0.5 0 0 0</pose>
      <link name="counter">
        <collision name="collision">
          <geometry><box><size>1.1 0.55 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.1 0.55 1.0</size></box></geometry>
          <material>
            <ambient>0.14 0.45 0.72 1</ambient>
            <diffuse>0.18 0.60 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="nurse_station_counter">
      <static>true</static>
      <pose>3.15 0.95 0.5 0 0 0</pose>
      <link name="counter">
        <collision name="collision">
          <geometry><box><size>1.1 0.55 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.1 0.55 1.0</size></box></geometry>
          <material>
            <ambient>0.36 0.16 0.58 1</ambient>
            <diffuse>0.58 0.28 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="lab_obstacle">
      <static>false</static>
      <allow_auto_disable>false</allow_auto_disable>
      <pose>0 2.2 0.35 0 0 0</pose>
      <link name="obstacle">
        <inertial>
          <mass>25.0</mass>
          <inertia>
            <ixx>1.4242</ixx>
            <iyy>1.4242</iyy>
            <izz>0.8067</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.44 0.44 0.70</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.44 0.44 0.70</size></box></geometry>
          <material>
            <ambient>0.72 0.04 0.04 1</ambient>
            <diffuse>0.95 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="lab_evidence_camera">
      <static>true</static>
      <pose>0 0 7.2 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="overhead_camera" type="camera">
          <topic>/flyto/evidence/overhead</topic>
          <update_rate>4</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.22</horizontal_fov>
            <image>
              <width>960</width>
              <height>540</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="corridor_camera_a">
      <static>true</static>
      <pose>-1.00 -1.10 2.50 0 1.15 1.5708</pose>
      <link name="camera_link">
        <sensor name="zone_a_camera" type="camera">
          <topic>/flyto/evidence/zone_a</topic>
          <update_rate>8</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.50</horizontal_fov>
            <image>
              <width>960</width>
              <height>540</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>12.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="corridor_camera_b">
      <static>true</static>
      <pose>1.20 -1.10 2.50 0 1.15 1.5708</pose>
      <link name="camera_link">
        <sensor name="zone_b_camera" type="camera">
          <topic>/flyto/evidence/zone_b</topic>
          <update_rate>8</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.50</horizontal_fov>
            <image>
              <width>960</width>
              <height>540</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>12.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://flyto_rover</uri>
      <name>flyto_rover</name>
      <pose>-2.15 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
