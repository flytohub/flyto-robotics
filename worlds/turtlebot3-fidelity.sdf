<?xml version="1.0"?>
<sdf version="1.8">
  <world name="flyto_turtlebot3_fidelity">
    <physics name="flyto_1ms_ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>5.64e-6 22.3e-6 -42.8e-6</magnetic_field>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.84 0.88 0.92 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light name="ceiling_key" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.35 0.2 -1</direction>
    </light>

    <model name="vinyl_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>8 6 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.72</mu><mu2>0.68</mu2></ode>
            </friction>
            <contact><ode><kp>1000000</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>8 6 0.04</size></box></geometry>
          <material>
            <ambient>0.73 0.76 0.78 1</ambient>
            <diffuse>0.73 0.76 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static><pose>0 3 0.6 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>8 0.10 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.10 1.2</size></box></geometry>
          <material><ambient>0.92 0.94 0.96 1</ambient><diffuse>0.92 0.94 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -3 0.6 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>8 0.10 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.10 1.2</size></box></geometry>
          <material><ambient>0.92 0.94 0.96 1</ambient><diffuse>0.92 0.94 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>4 0 0.6 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.10 6 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 6 1.2</size></box></geometry>
          <material><ambient>0.92 0.94 0.96 1</ambient><diffuse>0.92 0.94 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-4 0 0.6 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.10 6 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 6 1.2</size></box></geometry>
          <material><ambient>0.92 0.94 0.96 1</ambient><diffuse>0.92 0.94 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="mission_station_red">
      <static>true</static><pose>2.2 1.65 0.35 0 0 0</pose>
      <link name="station">
        <collision name="collision"><geometry><box><size>0.55 0.40 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.40 0.70</size></box></geometry>
          <material><ambient>0.60 0.05 0.05 1</ambient><diffuse>0.82 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="mission_station_blue">
      <static>true</static><pose>-2.1 1.65 0.35 0 0 0</pose>
      <link name="station">
        <collision name="collision"><geometry><box><size>0.55 0.40 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.40 0.70</size></box></geometry>
          <material><ambient>0.04 0.18 0.55 1</ambient><diffuse>0.06 0.30 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="movable_cart">
      <pose>1.1 -0.45 0.20 0 0 0.18</pose>
      <link name="cart">
        <inertial>
          <mass>8.0</mass>
          <inertia><ixx>0.35</ixx><iyy>0.35</iyy><izz>0.45</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.60 0.42 0.40</size></box></geometry>
          <surface><friction><ode><mu>0.60</mu><mu2>0.60</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.60 0.42 0.40</size></box></geometry>
          <material><ambient>0.68 0.55 0.20 1</ambient><diffuse>0.86 0.72 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
