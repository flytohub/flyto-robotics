<?xml version="1.0"?>
<sdf version="1.9">
  <world name="flyto_nav2_closed_loop">
    <physics name="default_physics" type="dart">
      <!-- 100 Hz remains above the 20 Hz controller and 10 Hz LiDAR while
           reducing scheduler starvation in the bounded simulation. -->
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.92 0.95 0.98 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry><box><size>8 8 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 8 0.10</size></box></geometry>
          <material>
            <ambient>0.62 0.66 0.68 1</ambient>
            <diffuse>0.82 0.86 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://flyto_rover</uri>
      <name>flyto_rover</name>
      <pose>0 0 0.06 0 0 0</pose>
    </include>
  </world>
</sdf>
