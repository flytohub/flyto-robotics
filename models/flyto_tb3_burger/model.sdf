<?xml version="1.0"?>
<!--
  A TurtleBot3 Burger at the dimensions that matter for clearance.

  flyto_rover is 42 x 30 cm. Driven down a 28 cm aisle it does not fit at all,
  so a "successful" run in one proves nothing about the geometry — it only means
  the lidar readings happened to clear the gate. This model exists so the
  question "does the real robot fit, and what does its lidar read when it does"
  can be answered before the robot is on the floor.

  Chassis 138 x 178 mm, 192 mm tall; wheels 66 mm across on a 160 mm track;
  about a kilogram. The lidar sits on the centreline near the top, which is why
  a corridor wall reads at half the aisle width rather than at the gap beside
  the chassis.

  Topics match flyto_rover exactly (/flyto/cmd_vel, /flyto/scan, /flyto/odom),
  so it drops into any of the bundled worlds unchanged.
-->
<sdf version="1.9">
  <model name="flyto_tb3_burger">
    <pose>0 0 0.033 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>0.9</mass>
        <inertia><ixx>0.0035</ixx><iyy>0.0035</iyy><izz>0.0050</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis">
        <pose>0 0 0.063 0 0 0</pose>
        <geometry><box><size>0.178 0.138 0.126</size></box></geometry>
      </collision>
      <visual name="chassis">
        <pose>0 0 0.063 0 0 0</pose>
        <geometry><box><size>0.178 0.138 0.126</size></box></geometry>
        <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
      </visual>
      <visual name="lidar_housing">
        <pose>0 0 0.145 0 0 0</pose>
        <geometry><cylinder><radius>0.0375</radius><length>0.040</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material>
      </visual>

      <!-- On the centreline near the top, as on the real unit: a corridor wall
           therefore reads at half the aisle width, not at the gap beside the
           chassis. That distinction is the whole reason this model exists. -->
      <sensor name="lds" type="gpu_lidar">
        <pose>0 0 0.159 0 0 0</pose>
        <topic>/flyto/scan</topic>
        <update_rate>5</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan><horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141593</min_angle>
            <max_angle>3.141593</max_angle>
          </horizontal></scan>
          <range><min>0.12</min><max>3.5</max><resolution>0.015</resolution></range>
          <!-- The real unit is noisy. A noiseless sweep would make the sector
               minima look steadier than they will be on the day. -->
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0 0.080 0 -1.570796 0 0</pose>
      <inertial><mass>0.028</mass>
        <inertia><ixx>1.1e-5</ixx><iyy>1.1e-5</iyy><izz>1.8e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.080 0 -1.570796 0 0</pose>
      <inertial><mass>0.028</mass>
        <inertia><ixx>1.1e-5</ixx><iyy>1.1e-5</iyy><izz>1.8e-5</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>

    <link name="caster">
      <pose>-0.075 0 -0.020 0 0 0</pose>
      <inertial><mass>0.005</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.013</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><sphere><radius>0.013</radius></sphere></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="caster_joint" type="ball">
      <parent>base_link</parent><child>caster</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <topic>/flyto/cmd_vel</topic>
      <odom_topic>/flyto/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
    </plugin>
  </model>
</sdf>
