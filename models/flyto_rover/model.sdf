<?xml version="1.0"?>
<sdf version="1.9">
  <model name="flyto_rover">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0.14 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.075</ixx>
          <iyy>0.135</iyy>
          <izz>0.195</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.42 0.30 0.14</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.42 0.30 0.14</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.28 0.42 1</ambient>
          <diffuse>0.04 0.48 0.70 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="payload_tray">
        <pose>-0.02 0 0.12 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.24 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.65 0.68 0.72 1</ambient>
          <diffuse>0.82 0.85 0.88 1</diffuse>
        </material>
      </visual>
      <visual name="locked_medication_container">
        <pose>-0.035 0 0.245 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.23 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.70 0.72 0.74 1</ambient>
          <diffuse>0.90 0.92 0.93 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>
      <visual name="container_lock_band">
        <pose>0.035 0 0.245 0 0 0</pose>
        <geometry>
          <box>
            <size>0.035 0.238 0.19</size>
          </box>
        </geometry>
        <material>
          <ambient>0.65 0.03 0.04 1</ambient>
          <diffuse>0.92 0.05 0.06 1</diffuse>
        </material>
      </visual>
      <visual name="status_light">
        <pose>0.075 0 0.357 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.58 0.24 1</ambient>
          <diffuse>0.03 0.82 0.34 1</diffuse>
          <emissive>0.01 0.36 0.12 1</emissive>
        </material>
      </visual>
      <visual name="camera_housing">
        <pose>0.235 0 0.075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.07 0.16 0.105</size>
          </box>
        </geometry>
        <material>
          <ambient>0.025 0.035 0.045 1</ambient>
          <diffuse>0.06 0.08 0.10 1</diffuse>
          <specular>0.55 0.55 0.55 1</specular>
        </material>
      </visual>
      <visual name="camera_lens">
        <pose>0.273 0 0.075 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.03 0.07 1</ambient>
          <diffuse>0.02 0.08 0.18 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <visual name="direction_marker">
        <pose>0.19 0 0.105 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.12 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.25 0.05 1</ambient>
          <diffuse>1 0.35 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.17 0.08 1.5708 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.002</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.17 0.08 1.5708 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.002</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_caster">
      <pose>-0.15 0 0.045 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.045</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.045</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="lidar_link">
      <pose>0.10 0 0.285 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>
      <sensor name="front_lidar" type="gpu_lidar">
        <topic>/flyto/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <link name="route_camera_link">
      <pose>0.32 0 0.30 0 1.5708 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00008</ixx>
          <iyy>0.00008</iyy>
          <izz>0.00008</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="route_camera" type="camera">
        <topic>/flyto/camera/image</topic>
        <update_rate>15</update_rate>
        <!-- The Nav2 lab does not consume video. Keep the optional camera
             demand-driven so it cannot starve safety-critical sensors. -->
        <always_on>false</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>160</width>
            <height>120</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>1.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
      </axis>
    </joint>
    <joint name="rear_caster_joint" type="ball">
      <parent>base_link</parent>
      <child>rear_caster</child>
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
    <joint name="route_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>route_camera_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>/flyto/cmd_vel</topic>
      <odom_topic>/flyto/odom</odom_topic>
      <tf_topic>/flyto/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>flyto_rover</robot_base_frame>
      <odom_topic>/flyto/ground_truth</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
