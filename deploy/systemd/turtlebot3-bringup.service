[Unit]
Description=TurtleBot3 hardware bringup (OpenCR + LDS lidar)
After=network-online.target
# The launch opens two serial ports the moment it starts. At boot they have not
# always enumerated yet, so it used to exit before the devices existed — and
# because it exited cleanly, Restart=on-failure never fired. The result was a
# unit systemd reported as active with no processes and no log for that boot.
#
# The start rate limit lives here, in [Unit], because that is the only section
# systemd reads it from; putting either key in [Service] is silently ignored.
#
# Production truth, and why the burst is 3 and not 20: this unit was found at
# NRestarts=193. What an operator saw was the LDS lidar flapping — /scan
# appearing and vanishing every minute or so — but the lidar was never the
# fault. turtlebot3_node kept failing its OpenCR/Dynamixel motor-bus handshake;
# the supervised launch group correctly tore the *whole* group down for that one
# dead process, taking the perfectly healthy lidar with it; Restart=always
# brought it straight back to fail the same way. A hardware fault was being
# retried forever and presented as an intermittent sensor.
#
# StartLimitBurst=20 could not stop that, and neither could any large burst: one
# full failure cycle here is ExecStartPre's device wait, plus the launch, plus
# the handshake attempt, plus RestartSec=5 — long enough that 20 starts never
# fit inside StartLimitIntervalSec=300, so the counter kept aging out and the
# limiter never tripped. The interval stays at 300s; the burst drops to 3, which
# does fit. Three failed starts within five minutes now park the unit in `failed`
# so a human inspects the board and clears it with `systemctl reset-failed`.
#
# This is a containment policy, not a repair: it does not fix the OpenCR/motor
# bus, it stops the robot from hiding a hardware fault behind a restart loop.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# notify, not simple: the launch group includes bringup_watchdog (see the
# launch wrapper), which defers READY=1 until the first /odom message (or a
# 10s startup grace) and then pings WATCHDOG=1 only while /odom stays fresh.
# This is what catches the 2026-08-07 failure OnProcessExit cannot see:
# turtlebot3_ros hung while alive — same PID, every topic silent, nothing
# exited. When /odom goes stale the watchdog stops pinging, the timer below
# expires, systemd kills the whole cgroup, and Restart=always starts it clean.
Type=notify
# The ping comes from a sibling process inside the launch group, not the main
# ros2 launch PID, so the default NotifyAccess=main would discard it.
NotifyAccess=all
# Detection latency after /odom goes stale is the watchdog's 5s freshness
# window plus this. 15s total ≈ 20s to an automatic restart — the same hang
# previously lasted until someone restarted the service by hand.
WatchdogSec=15
# ExecStartPre may legitimately take up to ~62s waiting for serial devices,
# and READY=1 now arrives up to ~10s after launch. The default 90s start
# timeout leaves too little margin on a slow cold boot; a start that is
# genuinely stuck still starves WatchdogSec afterwards.
TimeoutStartSec=120
User=ubuntu
Environment=TURTLEBOT3_MODEL=burger
Environment=LDS_MODEL=LDS-03
Environment=ROS_DOMAIN_ID=30
Environment=PYTHONUNBUFFERED=1
# Wait for both devices rather than assuming them, then give the OpenCR board
# a moment past that before anything tries to talk to it. The device file
# appears the instant the kernel enumerates the USB-serial adapter; the
# board's own firmware boot is a separate, slower thing behind it, and there
# is no public way to probe the board's own readiness short of running the
# same handshake turtlebot3_ros itself performs. This narrows the race, it
# does not close it — see the launch wrapper below for what actually closes it.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -e /dev/ttyACM0 ] && [ -e /dev/tb3_lidar ] && exit 0; sleep 1; done; echo "bringup: /dev/ttyACM0 or /dev/tb3_lidar never appeared" >&2; exit 1'
ExecStartPre=/bin/sleep 2
# turtlebot3_bringup_supervised.launch.py, not ROBOTIS's robot.launch.py
# directly: it includes the same launch and adds one thing ros2 launch does
# not do by default — bring the whole group down the moment any one of its
# three processes exits. Without that, a first-attempt OpenCR handshake
# failure leaves turtlebot3_ros dead while lidar and robot_state_publisher
# keep running, systemd sees the unit as continuously active, and
# Restart=always below never fires. Verified 2026-08-07: this exact failure
# happened on a cold boot and needed a manual restart to clear.
#
# Called by absolute path, not by package name. flyto_robotics is installed
# here with `pip install -e .`, not colcon, so it carries no ament resource
# index entry — `ros2 launch flyto_robotics <file>` reports "Package not
# found" on this robot. `ros2 launch` resolves a path argument directly
# without needing one, which this deployment shape actually supports.
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec ros2 launch /home/ubuntu/flyto-robotics/launch/turtlebot3_bringup_supervised.launch.py'
# always, not on-failure: a clean exit is exactly how this failed silently,
# and the wrapper above turns "one node died" into the whole group exiting —
# which must be retried the same way a crash is. Unchanged by the NRestarts=193
# finding: retrying is still right for a transient race or a watchdog kill. What
# changed is that [Unit]'s StartLimitBurst=3 now bounds how long "always" is
# allowed to keep retrying something that is not transient.
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
