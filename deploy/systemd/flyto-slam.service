# SLAM, as a unit rather than something a person holds open in a terminal.
#
# The device executor that starts mapping is a short-lived subprocess: the
# registry runs it with a bounded timeout (300 s ceiling), an empty environment
# and stderr discarded, then reaps it. So it cannot be the thing that owns
# slam_toolbox — a mapping run outlives any one request by design, because the
# driving happens between the request that starts it and the request that saves
# the map. This unit is what actually holds it.
#
# ## Conflicts with Nav2, deliberately
#
# slam_toolbox and Nav2's map_server both publish /map, and both localise. Run
# together they fight: AMCL corrects against a map that SLAM is still redrawing
# under it, and the robot's idea of where it is depends on which publisher won
# the last latch. Mapping a venue and navigating it are different phases of the
# same day, never the same minute, so systemd is told to enforce that instead
# of it being a thing an operator has to remember at a trade show.
[Unit]
Description=Flyto SLAM (map recording)
After=turtlebot3-bringup.service
Requires=turtlebot3-bringup.service
Conflicts=flyto-nav2.service

[Service]
Type=simple
User=ubuntu
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=30
Environment=TURTLEBOT3_MODEL=burger
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec ros2 launch slam_toolbox online_async_launch.py use_sim_time:=False'
Restart=no
KillSignal=SIGINT
TimeoutStopSec=20

# Never enabled. A robot that boots into mapping mode has thrown away the map
# it recorded yesterday before anyone has typed anything.
[Install]
WantedBy=
