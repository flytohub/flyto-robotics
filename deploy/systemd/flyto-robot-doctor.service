[Unit]
Description=Flyto robot network and service diagnostic snapshot
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/flyto-robotics
EnvironmentFile=/etc/flyto/robot-recovery.env
# This unit runs as root, so its journal is root-owned and 0600. It is a
# different file from the job runner's, which the ubuntu service user writes:
# pointing both at one path would mean loosening it for one of them, and a
# device journal that group or others can read is already disclosed.
#
# Not inside diagnostics/. The journal owns the mode of the directory it lives
# in and tightens it to 0700, and the recovery portal serves latest.json out of
# diagnostics/ under another account — so sharing one directory would take the
# portal's read away the first time this recorded anything.
Environment=FLYTO_DEVICE_EVENT_JOURNAL=/var/lib/flyto-robot/events/device-events.jsonl
ExecStart=/usr/bin/python3 -m flyto_robotics.robot_doctor --resource-id ${FLYTO_ROBOT_RESOURCE_ID} --cloud-url ${FLYTO_CLOUD_URL} --event-journal ${FLYTO_DEVICE_EVENT_JOURNAL}
UMask=0022
StateDirectory=flyto-robot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/flyto-robot
