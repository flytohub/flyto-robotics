[Unit]
Description=Flyto2 job runner (claims Space task jobs for this robot)
After=network-online.target turtlebot3-bringup.service flyto-delivery.service
Wants=network-online.target
# The gateway is what actually drives the robot; claiming a job before it can
# accept one only produces a failed job.
Requires=flyto-delivery.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/home/ubuntu/flyto-delivery.env

# -- keeping the device secret to this service ---------------------------
#
# The runner holds a device credential it must be able to read unattended at
# boot. It creates that file at 0600 itself; this is the second line, so a
# future write that forgets loses nothing. 0077 means nothing this process
# creates is readable by anyone but its owner, whatever the code asks for.
UMask=0077
# Nothing here needs to gain privileges, reach another user's namespace, or
# write to the system tree. Saying so costs nothing and removes the paths an
# attacker who reached this process would otherwise have.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
#
# On a host that can do better than a file — one with a TPM — provision the
# credential out of band and let systemd hand it over in memory instead:
#
#   systemd-creds encrypt --name=flyto-device creds.json /etc/flyto/device.cred
#   LoadCredentialEncrypted=flyto-device:/etc/flyto/device.cred
#
# The runner prefers $CREDENTIALS_DIRECTORY when it is present, so nothing on
# disk is read and nothing is written. This robot is a Raspberry Pi 4 with no
# TPM and it pairs itself, so it uses the file: a device that must read its own
# secret with no operator present cannot hold a key the SD card does not.

Environment=PYTHONUNBUFFERED=1
Environment=FLYTO_RUNNER_DATA_DIR=/home/ubuntu/.flyto
Environment=FLYTO_PLAN_ROOT=/home/ubuntu/flyto-robotics/examples/plans
# Which robot this is. A canvas-authored motion step says how far to go, not
# who goes; the gateway checks a plan's robot_id against its own job, so this
# is where the two are tied together. It must match the robot_id in the job
# the delivery gateway was started with.
Environment=FLYTO_ROBOTICS_ROBOT_ID=flyto-tb3-lab-001
# The runner reads one thing from flyto-modules-robotics — the table that says
# which module identifier means which plan, which the workflow engine reads on
# the other side, so the canvas and the robot cannot disagree about what a
# step means.
#
# It comes from PyPI, into a venv of its own, pinned. It used to be a
# PYTHONPATH pointing at an rsync'd working tree, which meant the robot ran
# whatever happened to be in a developer's checkout — uncommitted edits
# included — and an upgrade was a side effect of a file copy rather than a
# decision. Provisioned with:
#
#   python3 -m venv /home/ubuntu/.flyto/runner-venv
#   /home/ubuntu/.flyto/runner-venv/bin/pip install "flyto-modules-robotics==0.1.0"
# The runner inside the deployed tree, not a copy beside it. A second copy at
# /home/ubuntu/flyto_job_runner.py is what the unit used to run, and rsync
# updates the tree — so the robot kept executing a stale runner after every
# deploy. It cost one live mission: the fixed runner knew the gateway says
# "completed", the stale one was still waiting for "succeeded" and would have
# timed out at five minutes reporting "outcome unknown".
ExecStart=/home/ubuntu/.flyto/runner-venv/bin/python /home/ubuntu/flyto-robotics/deploy/flyto_job_runner.py
# always, not on-failure: the runner exits cleanly on a rejected credential and
# on SIGTERM, and only the first of those should bring it back.
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=20
# It finishes the job in hand before stopping, so give it room.
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
