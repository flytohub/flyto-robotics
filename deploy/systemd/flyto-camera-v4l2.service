# The one process that opens the camera.
#
# A UVC device admits a single streaming opener, so the driver, the observation
# gateway and the MJPEG server cannot each hold /dev/video0. This unit owns the
# device and publishes /camera/image_raw; the other two subscribe. That is also
# why this is a separate unit rather than part of either consumer — whichever
# one started first would otherwise lock the other out of the camera.
#
# by-id rather than /dev/video0: the enumeration order is not stable across a
# replug, and video0 was the webcam only because the Pi ISP nodes happened to
# register later. ConditionPathExists keeps an unplugged camera from being a
# restart loop — the unit stays inactive until the device is back.
[Unit]
Description=Flyto robot camera V4L2 to ROS 2 publisher
After=network-online.target
Wants=network-online.target
ConditionPathExists=/dev/v4l/by-id/usb-XC-TECH_Web_Camera_20251103.1921-video-index0

[Service]
Type=simple
User=ubuntu
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=30
# output_encoding=rgb8 is required, not cosmetic: camera_observation.accept_image
# admits only rgb8/bgr8 with step == width*3 and clears the observation for
# anything else, so a YUYV passthrough would read as a camera that never saw.
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec ros2 run v4l2_camera v4l2_camera_node --ros-args \
  -r __ns:=/camera \
  -p video_device:=/dev/v4l/by-id/usb-XC-TECH_Web_Camera_20251103.1921-video-index0 \
  -p output_encoding:=rgb8 \
  -p image_size:=[640,480]'
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
