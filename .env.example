# Optional additional Gazebo model and world search roots.
# The launch file always prepends this repository's installed models directory.
GZ_SIM_RESOURCE_PATH=

# Optional Gazebo system-plugin search roots for custom hardware adapters.
# Bundled Harmonic plugins are discovered from the ROS 2 installation.
GZ_SIM_SYSTEM_PLUGIN_PATH=
FLYTO_ROBOTICS_PLANNER_URL=https://planner.example.com/v1/robot-plan
FLYTO_ROBOTICS_PLANNER_TOKEN=

# Required only for plans containing ask_human. Use a random value of at least
# 32 bytes and inject it through the device secret store; never commit it.
FLYTO_ROBOTICS_APPROVAL_SECRET=

# Generic ROS 2 adapter: what a robot's motions rest on.
# lidar_clearance (default) or operator_present; see README "Motion safety basis".
FLYTO_ROS2_SAFETY_BASIS=lidar_clearance

# Optional: path to ros_gz_bridge's parameter_bridge. When unset, PATH and
# /opt/ros/$ROS_DISTRO/lib/ros_gz_bridge/ are searched.
FLYTO_ROBOTICS_PARAMETER_BRIDGE=

# Generic ROS 2 adapter: managed SSH local forward to a robot whose services bind
# to its loopback (see README "Reaching a loopback-bound robot"). Setting the host
# turns it on and implies the rosbridge transport; leave FLYTO_ROSBRIDGE_URL unset
# (it is derived from the forward). Key-only, StrictHostKeyChecking=yes.
FLYTO_ROS2_SSH_HOST=
FLYTO_ROS2_SSH_IDENTITY=
FLYTO_ROS2_SSH_KNOWN_HOSTS=
FLYTO_ROS2_SSH_FORWARDS=rosbridge=9090
FLYTO_ROS2_SSH_LOCAL_PORTS=

# Footprint radius about the centre of rotation, for the rotate preflight
# (floor + radius all around) and the straight-drive corridor width.
FLYTO_ROS2_ROBOT_RADIUS_M=0.1