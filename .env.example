# Optional additional Gazebo model and world search roots.
# The launch file always prepends this repository's installed models directory.
GZ_SIM_RESOURCE_PATH=

# Optional Gazebo system-plugin search roots for custom hardware adapters.
# Bundled Harmonic plugins are discovered from the ROS 2 installation.
GZ_SIM_SYSTEM_PLUGIN_PATH=
FLYTO_ROBOTICS_PLANNER_URL=https://planner.example.com/v1/robot-plan
FLYTO_ROBOTICS_PLANNER_TOKEN=

# Required only for plans containing ask_human. Use a random value of at least
# 32 bytes and inject it through the device secret store; never commit it.
FLYTO_ROBOTICS_APPROVAL_SECRET=
